# Copy to backend/.env. Existing process environment takes precedence.
APP_NAME=self-studying-agent
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Omit DATABASE_PATH for backend/data/tutor.sqlite3; set an absolute path to override.
# DATABASE_PATH=C:/path/to/tutor.sqlite3

# No model calls or fabricated subject-specific fallback lessons when disabled.
LLM_ENABLED=false
LLM_API_KEY=
# OpenAI-compatible service root (the client appends /chat/completions).
LLM_BASE_URL=https://api.openai.com/v1
# Set a model supported by your provider, with JSON-object output support.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
# Optional independent verification model; empty uses LLM_MODEL in a separate call.
LLM_VERIFY_MODEL=
# Enable only when both the teaching model and verification model support image_url.
LLM_VISION_ENABLED=false
